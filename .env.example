# Copy to .env and fill values.
# Never commit your real .env

# Camera
CAMERA_IP=192.168.100.9
CAMERA_USER=admin
CAMERA_PASS=CHANGE_ME

# DVRIP/RTSP ports
DVRIP_PORT=34567
RTSP_PORT=554

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SSL_VERIFY=1
TELEGRAM_CA_BUNDLE=

# Alarm pipeline
ALARM_POLL_INTERVAL=300
ALARM_DEBUG_DUMP=0
ALARM_TG_REQUIRE_PHOTO=1
ALARM_EXTRACT_WORKERS=1
ALARM_POLL_LOOKBACK_SEC=3600
ALARM_NOTIFY_GROUP_SEC=60
ALARM_EVENT_GROUP_SEC=30
ALARM_BOOTSTRAP_HOURS=24
ALARM_POLL_LOG_EVERY_TICK=1
ALARM_HISTORY_USE_EVENT_CLUSTER=0
QUIET_HTTP_ACCESS_LOGS=1

# RTSP stability
RTSP_NO_FRAME_TIMEOUT_SEC=15

# Remote upstream push (optional)
# Example: rtmp://YOUR_SERVER_IP/live/cam1
REMOTE_PUSH_URL=
REMOTE_PUSH_TRANSPORT=tcp
FFMPEG_BIN=ffmpeg
REMOTE_PUSH_LOG_TO_CONSOLE=1
REMOTE_PUSH_CODEC=libx264
REMOTE_PUSH_PRESET=veryfast
REMOTE_PUSH_TUNE=zerolatency
REMOTE_PUSH_FPS=12
REMOTE_PUSH_SCALE_HEIGHT=720
REMOTE_PUSH_STREAM_INDEX=1

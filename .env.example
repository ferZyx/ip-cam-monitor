# Copy to .env and fill values.
# Never commit your real .env

# Camera
# IP-адрес камеры в локальной сети.
CAMERA_IP=192.168.100.9
# Имя пользователя камеры.
CAMERA_USER=admin
# Пароль камеры; не коммить реальные значения.
CAMERA_PASS=CHANGE_ME

# DVRIP/RTSP ports
# DVRIP-порт камеры Xiongmai для discovery и fallback snapshot.
DVRIP_PORT=34567
# RTSP-порт камеры для видеопотока.
RTSP_PORT=554

# Telegram (optional)
# Токен Telegram Bot API; оставь пустым, чтобы отключить Telegram.
TELEGRAM_BOT_TOKEN=
# ID чата или канала, куда отправлять сообщения Telegram.
TELEGRAM_CHAT_ID=
# Проверять SSL-сертификат Telegram API: 1 включено, 0 отключено.
TELEGRAM_SSL_VERIFY=1
# Путь к custom CA bundle для Telegram SSL; обычно оставить пустым.
TELEGRAM_CA_BUNDLE=

# Yellow-box Telegram alerts (optional)
# Включить yellow-box тревоги: 1 включено, 0 выключено.
YELLOW_BOX_ALERT_ENABLED=0
# Интервал проверки последнего кадра на жёлтую рамку, в секундах.
YELLOW_BOX_CHECK_INTERVAL_SEC=1
# Минимальная пауза между постановкой yellow-box тревог в очередь, в секундах.
YELLOW_BOX_ALERT_MIN_INTERVAL_SEC=3
# Минимальная уверенность детектора для тревоги.
YELLOW_BOX_MIN_CONFIDENCE=0.5
# Максимальная ширина кадра для детекции; меньше значение снижает нагрузку CPU.
YELLOW_BOX_DETECTION_MAX_WIDTH=640
# Лимит Telegram-отправок из очереди в минуту.
YELLOW_BOX_TELEGRAM_RATE_PER_MINUTE=20
# Максимальный размер локальной очереди Telegram; при переполнении старые кадры удаляются.
YELLOW_BOX_TELEGRAM_QUEUE_SIZE=20

# Logging
# Скрывать стандартные HTTP access-логи Flask/Werkzeug: 1 скрывать, 0 показывать.
QUIET_HTTP_ACCESS_LOGS=1

# RTSP stability
# Сколько секунд ждать RTSP-кадры перед переподключением.
RTSP_NO_FRAME_TIMEOUT_SEC=15

# Remote upstream push (optional)
# Example: rtmp://YOUR_SERVER_IP/live/cam1
# Внешний URL для ffmpeg push; оставь пустым, чтобы отключить remote push.
REMOTE_PUSH_URL=
# Транспорт RTSP-входа для ffmpeg relay.
REMOTE_PUSH_TRANSPORT=tcp
# Путь или имя бинарника ffmpeg.
FFMPEG_BIN=ffmpeg
# Печатать лог ffmpeg в консоль сервера: 1 включено, 0 выключено.
REMOTE_PUSH_LOG_TO_CONSOLE=1
# Видеокодек для remote push; libx264 стабильнее для внешнего просмотра.
REMOTE_PUSH_CODEC=libx264
# Preset encoder-а ffmpeg при транскодировании.
REMOTE_PUSH_PRESET=veryfast
# Tune encoder-а ffmpeg для низкой задержки.
REMOTE_PUSH_TUNE=zerolatency
# FPS выходного remote push потока.
REMOTE_PUSH_FPS=12
# Высота выходного remote push потока; ширина считается автоматически.
REMOTE_PUSH_SCALE_HEIGHT=720
# Индекс RTSP-потока камеры для remote push: 0 main, 1 sub.
REMOTE_PUSH_STREAM_INDEX=1
